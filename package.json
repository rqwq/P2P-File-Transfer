{
  "name": "p2p-file-transfer",
  "productName": "P2P File Transfer",
  "version": "0.1.0",
  "description": "Serverless peer-to-peer file transfer - rooms, chat and direct transfers over HyperDHT or a VPN adapter",
  "main": "./out/main/index.js",
  "author": "P2P File Transfer",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:build": "node scripts/check-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "gen:assets": "node scripts/gen-assets.mjs",
    "user2": "node scripts/test-second-user.mjs",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.p2pft.app",
    "productName": "P2P File Transfer",
    "directories": {
      "output": "dist",
      "buildResources": "build_resources"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build_resources/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "differentialPackage": false
    },
    "afterPack": "./scripts/after-pack-fuses.cjs",
    "publish": {
      "provider": "github",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.6.0",
    "b4a": "^1.6.7",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.2.3",
    "electron-updater": "^6.6.2",
    "hyperdht": "^6.23.0",
    "hyperswarm": "^4.8.1",
    "marked": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "javascript-obfuscator": "^5.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
